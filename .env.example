# Exemplo de variáveis de ambiente do backend Sunny Sales.
# Copia para `.env` e preenche com valores reais. NUNCA commitar o `.env`.

# --- Base de dados ---
# PostgreSQL em produção; se vazio, cai para SQLite local (./app.db).
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Segurança ---
# Chave para assinar tokens JWT. OBRIGATÓRIA em produção.
# Gera uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Token para os endpoints de administração (/admin/*, ativação manual).
ADMIN_TOKEN=

# --- CORS / Hosts ---
# Lista separada por vírgulas das origens autorizadas do frontend.
ALLOWED_ORIGINS=https://o-teu-dominio.com
# Hosts adicionais autorizados (TrustedHostMiddleware), separados por vírgulas.
ALLOWED_HOSTS=o-teu-dominio.com

# --- URLs da aplicação ---
BASE_APP_URL=https://o-teu-dominio.com

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Sunny Sales <onboarding@resend.dev>
CONTACT_EMAIL_TO=sunnysales.geral@gmail.com

# --- Stripe ---
# O Premium é a única compra da plataforma e é vendido como PAGAMENTO ÚNICO
# (mode=payment), sem renovação automática. O preço é definido no backend
# (price_data), pelo que NÃO são precisos price IDs.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Destinos após o checkout (por omissão apontam para /dashboard e /premium).
SUCCESS_URL=https://o-teu-dominio.com/dashboard
CANCEL_URL=https://o-teu-dominio.com/premium

# --- Premium ---
# Há dois estados: gratuito ou Premium. O gratuito já põe o vendedor no mapa;
# o Premium acrescenta estrela no pin, mais alcance e fotos nos produtos, por
# 30 dias e num pagamento único.
# PREMIUM_PRICE_EUR=19.99
# Raio (metros) a que o vendedor é encontrado no mapa do banhista.
# FREE_REACH_RADIUS_M=300
# PREMIUM_REACH_RADIUS_M=1000

# --- Observabilidade (opcional) ---
# Se definires um DSN do Sentry, os erros do backend passam a ser reportados.
# Deixa vazio para desligar (por omissão está desligado).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Supabase (armazenamento de ficheiros, opcional) ---
# Se não definido, os ficheiros são guardados localmente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
